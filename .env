APP_ENV=production
APP_DEBUG=0
APP_URL=https://towerslot.site
APP_SECRET=tQCpDxSLzNBIYPdAGXfFJTr4nhMq1616cF3yU&5h

# ---------------- Banco de dados ----------------
# O site usa SQLite (arquivo api/storage/database.sqlite) - e onde estao os
# usuarios ja cadastrados. Nao troque para mysql sem migrar os dados.
DB_DRIVER=sqlite
DB_PATH=api/storage/database.sqlite

# Dados MySQL (so usados se DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u882996991_jumppmil12
DB_USER=u882996991_jumppmil12
DB_PASS=Jumpgamer@1
