# publicado e testado, rodando na rede da Cloudflare (custo zero).
# Nao precisa de proxy pago nem trocar de hospedagem.
# ============================================================
AMPLOPAY_BASE_URL=https://project--3245543f-8718-474d-85d4-30e2ea3e80c1-dev.lovable.app/api/public/amplopay/api/v1
